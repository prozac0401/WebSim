  "metadata": {
    "coverage": "Photo-confirmed pit complex, mapped grandstand tiers and east-side hotel/condominium; simplified procedural architecture.",
    "reviewedDate": "2026-10-27",
    "limitations": [
      "Facility footprints are OSM-derived; heights, seat rows, canopy trusses and facade modules are image-based approximations, not a surveyed architectural model.",
      "LAP/TIME gantry is placed near the photographed south end of the pit building; longitudinal uncertainty is approximately ±40 m. It is separate from the simulation distance origin and the official START LINE.",
      "Hotel and condominium front curves follow their mapped outline; rear depth and repeated glazing/balcony modules are simplified. Grounds use adjacent-road estimated elevation.",
      "Source photographs are local references only; no photograph or third-party texture is distributed."
    ],
    "geometryMethod": "OSM footprints and pit-lane centerlines transformed with TrackRace.buildTrack(circuit).projection; apron/wall offsets visually estimated from photographs.",
    "attribution": "© OpenStreetMap contributors",
    "license": "ODbL-1.0",
    "licenseUrl": "https://opendatacommons.org/licenses/odbl/1-0/",
    "referenceMediaDistribution": "Photographs/PDFs retained in gitignored output/pit-references for local verification only; no source image is bundled.",
    "focusFeatureId": "inje-garages"
  },
